rules_version = '2';

// Essence POS
// /stores/{storeId}                    → { memberUids: [uid…], adminUids: [uid…], accounts: {uid: {email, role, name}} }
// /stores/{storeId}/{collection}/{id}  → store data (orders, products, settings, …)
//
// Logins are created by an admin (there is no public sign-up in the app). Members (tills and the
// owner dashboard) can read and write store data; only admins can add or remove logins.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function storeData(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data;
    }

    function isMember(storeId) {
      return signedIn() && request.auth.uid in storeData(storeId).memberUids;
    }

    match /stores/{storeId} {
      // Reading a store that doesn't exist yet is allowed so setup can tell new from existing.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberUids);

      // The seeded admin claims an unclaimed store: they must be its only member and admin.
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.adminUids == [request.auth.uid];

      // Only admins manage logins, and an admin can't remove their own access.
      allow update: if signedIn()
        && request.auth.uid in resource.data.adminUids
        && request.auth.uid in request.resource.data.adminUids
        && request.auth.uid in request.resource.data.memberUids;

      allow delete: if false;

      match /{collection}/{docId} {
        allow read, write: if isMember(storeId);
      }

      // ── Public store website (no sign-in) ──
      // The menu and the website's store info are public. Staff, settings, orders etc. stay members-only.
      match /products/{id} {
        allow read: if true;
      }
      match /categories/{id} {
        allow read: if true;
      }
      match /modifierGroups/{id} {
        allow read: if true;
      }
      match /public/{id} {
        allow read: if true;
      }

      // Pickup orders from the website: create-only, never readable or editable by the public.
      // A till turns each one into a held order and prices it from its own menu.
      match /webOrders/{code} {
        allow create: if isWebOrder(storeId, code, request.resource.data);
      }
    }

    // Order ID: 5 characters without look-alikes (no I, L, O, 0, 1).
    function isWebOrder(storeId, code, d) {
      return code.matches('^[A-HJKMNP-Z2-9]{5}$')
        && d.keys().hasAll(['code', 'phone', 'lines', 'status', 'createdAt'])
        && d.keys().hasOnly(['code', 'phone', 'name', 'note', 'lines', 'status', 'createdAt', 'subtotal'])
        && d.code == code
        && d.phone is string && d.phone.matches('^03[0-9]{9}$')
        && (!('name' in d) || (d.name is string && d.name.size() <= 40))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && (!('subtotal' in d) || (d.subtotal is int && d.subtotal >= 0 && d.subtotal <= 100000000))
        && d.lines is list && d.lines.size() >= 1 && d.lines.size() <= 30
        && d.status == 'new'
        && d.createdAt == request.time
        && get(/databases/$(database)/documents/stores/$(storeId)/public/site).data.get('accepting', false) == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
