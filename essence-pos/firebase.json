          "fileOutput": "android/app/google-services.json"
        }
      },
      "macos": {
        "default": {
          "projectId": "essenceisb",
          "appId": "1:976460236198:ios:17abb022135def17ff7b67",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "essenceisb",
          "configurations": {
            "android": "1:976460236198:android:45dd248b1cd965e2ff7b67",
            "macos": "1:976460236198:ios:17abb022135def17ff7b67",
