{
  "name": "essence-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "menu": "node scripts/fetch-menu.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "astro dev",
    "build": "node scripts/fetch-menu.mjs && astro build",
    "build:offline": "astro build",
    "preview": "astro preview",
