  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "puppeteer-core": "^25.15.0",
    "typescript": "^6.0.3"
  }
