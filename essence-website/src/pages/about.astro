---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Leaf from '../components/Leaf.astro';
import { site } from '../site.config';
import { photoFor } from '../lib/images';
import { about, seo } from '../content/copy';

const art = [photoFor('m-tres-leches'), photoFor('m-salted-caramel-cheesecake')];
const schema = [
  { '@type': 'AboutPage', name: about.title, url: `${site.url}/about`, about: { '@id': `${site.url}/#business` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: about.title, item: `${site.url}/about` },
    ],
  },
];
---

<Base title={seo.about.title} description={seo.about.description} path="/about" schema={schema}>
  <section class="about">
    <Leaf draw class="about__leaf" />
    <div class="wrap about__grid">
      <div class="about__copy">
        <p class="eyebrow">Patisserie · Coffee · Dessert Lounge</p>
        <h1 class="display">{about.title}</h1>
        <p class="about__body">{about.body}</p>
        <div class="about__ctas">
          <a class="btn" href="/menu" data-magnetic>Explore the Menu <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href="/contact">Contact Us</a>
        </div>
      </div>
      <div class="about__art" aria-hidden="true">
        {
          art.map(
            (photo, i) =>
              photo && (
                <div class={`about__img about__img--${i}`}>
                  <div class="arch">
                    <Picture src={photo} formats={['avif', 'webp']} widths={[280, 360]} sizes="(max-width: 860px) 46vw, 300px" alt="" loading="eager" />
                  </div>
                </div>
              ),
          )
        }
      </div>
    </div>
  </section>

  <section class="section pillars textured">
    <Leaf draw class="sprig sprig--tl" />
    <div class="wrap pillars__grid">
      {
        about.pillars.map((p, i) => (
          <article class="pillar" data-reveal style={`--i:${i}`}>
            <span class="pillar__n">0{i + 1}</span>
            <h2>{p.title}</h2>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
    <p class="pillars__cta" data-reveal>
      Planning a gathering? <a href="/corporate-events">Corporate & events enquiries</a>
    </p>
  </section>
</Base>

<style>
  .about {
    position: relative;
    padding: calc(var(--nav-h) + clamp(40px, 7vw, 100px)) 0 clamp(70px, 9vw, 120px);
    overflow: hidden;
  }
  .about :global(.about__leaf) {
    position: absolute;
    right: -40px;
    top: 90px;
    width: clamp(150px, 18vw, 260px);
    color: var(--olive);
    opacity: 0.45;
    transform: scaleX(-1);
  }
  .about__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .about__copy {
    display: grid;
    gap: 22px;
    animation: rise-in 1.1s 0.1s var(--ease) both;
  }
  .about__body {
    font: 500 clamp(1.15rem, 1.8vw, 1.45rem) / 1.55 var(--serif);
    color: var(--ink);
    max-width: 46ch;
  }
  .about__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--olive);
  }
  .about__art {
    position: relative;
    height: clamp(400px, 44vw, 560px);
  }
  .about__img {
    position: absolute;
    width: 54%;
    animation: rise-in 1.3s var(--ease) both;
  }
  .about__img .arch {
    aspect-ratio: 3 / 4;
    box-shadow: var(--shadow);
  }
  .about__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__img--0 {
    left: 0;
    top: 0;
    animation-delay: 0.2s;
  }
  .about__img--1 {
    right: 0;
    bottom: 0;
    animation-delay: 0.4s;
  }
  .about__img--1 .arch {
    outline: 1px solid var(--sand);
    outline-offset: 12px;
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.4vw, 28px);
  }
  .pillar {
    display: grid;
    gap: 10px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 26px;
    background: rgb(255 253 248 / 78%);
    box-shadow: inset 0 0 0 1px var(--sand), 0 24px 50px -36px rgb(43 33 24 / 45%);
  }
  .pillar__n {
    font: italic 500 2.4rem/1 var(--serif);
    color: var(--coffee);
  }
  .pillar h2 {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
  }
  .pillar p {
    color: var(--muted);
  }
  .pillars__cta {
    text-align: center;
    margin-top: clamp(40px, 5vw, 64px);
    color: var(--muted);
  }
  .pillars__cta a {
    color: var(--olive);
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .about__grid,
    .pillars__grid {
      grid-template-columns: 1fr;
    }
    .about__art {
      height: min(100vw, 460px);
    }
  }
</style>
