---
import Base from '../layouts/Base.astro';
import Leaf from '../components/Leaf.astro';
---

<Base title="Page not found | Essence" description="This page doesn’t exist. Explore the Essence dessert menu instead." path="/404">
  <section class="nf">
    <Leaf draw class="nf__leaf" />
    <p class="script">Oh, crumbs.</p>
    <h1 class="display">This slice is gone.</h1>
    <p class="lead">The page you’re looking for doesn’t exist, but there’s plenty of cake left.</p>
    <a class="btn" href="/menu">See the menu</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 90svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 20px;
    padding: calc(var(--nav-h) + 40px) var(--gutter) 80px;
  }
  .nf .script {
    font-size: 3rem;
    color: var(--coffee);
  }
  .nf :global(.nf__leaf) {
    width: 120px;
    color: var(--olive);
  }
</style>
