---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import Leaf from '../../components/Leaf.astro';
import WaAsk from '../../components/WaAsk.astro';
import { site } from '../../site.config';
import { type Product, categoryOf, hasOptions, menu, slugOf } from '../../lib/menu';
import { photoFor } from '../../lib/images';
import { pickup } from '../../content/copy';

export function getStaticPaths() {
  return menu.products.map((p) => ({ params: { slug: slugOf(p.id) }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const slug = slugOf(p.id);
const cat = categoryOf(p);
const photo = photoFor(p.id);
const title = `${p.name} | ESSENCE Bahria Town Phase 8, Rawalpindi`;
const tail = ' At ESSENCE, Bahria Town Phase 8, Rawalpindi.';
const description = p.description.length + tail.length <= 160 ? p.description + tail : p.description;
const related = [...menu.products.filter((x) => x.id !== p.id && x.categoryId === p.categoryId), ...menu.products.filter((x) => x.categoryId !== p.categoryId)].slice(0, 4);
const url = `${site.url}/menu/${slug}`;

const schema = [
  {
    '@type': 'MenuItem',
    '@id': `${url}#item`,
    name: p.name,
    description: p.description,
    url,
    ...(photo ? { image: new URL(photo.src, site.url).href } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Menu', item: `${site.url}/menu` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---

<Base title={title} description={description} path={`/menu/${slug}`} schema={schema}>
  <article class="item" data-product={p.id} data-sold={!p.available ? '' : undefined}>
    <div class="wrap item__grid">
      <div class="item__media">
        <Leaf draw class="item__leaf" />
        <div class="arch item__img">
          {
            photo && (
              <Picture
                src={photo}
                formats={['avif', 'webp']}
                widths={[360]}
                sizes="(max-width: 860px) 80vw, 420px"
                alt={`ESSENCE ${p.name.toLowerCase()}`}
                loading="eager"
                fetchpriority="high"
                style={`view-transition-name: p-${slug}`}
              />
            )
          }
        </div>
      </div>
      <div class="item__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span> <a href="/menu">Menu</a> <span>/</span> <span aria-current="page">{p.name}</span>
        </nav>
        {cat && <p class="eyebrow">{cat.name}</p>}
        <h1 class="item__title">{p.name}</h1>
        <p class="item__desc">{p.description}</p>
        <span class="chip chip--sold item__sold">Currently unavailable</span>
        <div class="item__buy">
          {
            hasOptions(p) ? (
              <button class="btn" type="button" data-add={p.id} data-options disabled={!p.available}>
                Choose & add <Icon name="plus" />
              </button>
            ) : (
              <>
                <div class="qty" data-qty>
                  <button type="button" data-step="-1" aria-label="Fewer">−</button>
                  <output>1</output>
                  <button type="button" data-step="1" aria-label="More">+</button>
                </div>
                <button class="btn" type="button" data-add={p.id} data-with-qty disabled={!p.available}>
                  Add to order <Icon name="plus" />
                </button>
              </>
            )
          }
          <WaAsk message={`I'd like to ask about the ${p.name}.`} class="item__wa" />
        </div>
        <p class="item__pickup"><Icon name="bag" /> {pickup.banner}</p>
        <p class="item__events">Ordering for an office meeting or a celebration? <a href="/corporate-events">Corporate & events enquiries</a></p>
      </div>
    </div>

    <section class="wrap related" aria-labelledby="related-h">
      <h2 id="related-h" class="h2" data-reveal>You may also <em class="accent">love</em></h2>
      <div class="related__grid" data-stagger>
        {related.map((r, i) => <ProductCard product={r} index={i} />)}
      </div>
    </section>
  </article>
</Base>

<style>
  .item {
    padding-top: calc(var(--nav-h) + clamp(32px, 6vw, 80px));
  }
  .item__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(36px, 6vw, 96px);
    align-items: center;
  }
  .item__media {
    position: relative;
    justify-self: center;
    width: min(420px, 82vw);
  }
  .item__img {
    aspect-ratio: 3 / 4;
    box-shadow: 0 50px 90px -40px rgb(34 21 14 / 55%);
    outline: 1px solid var(--sand);
    outline-offset: 14px;
  }
  .item__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .item[data-sold] .item__img :global(img) {
    filter: grayscale(0.7);
  }
  .item__media :global(.item__leaf) {
    position: absolute;
    left: -30%;
    top: -8%;
    width: 50%;
    color: var(--olive);
    opacity: 0.6;
  }
  .item__copy {
    display: grid;
    gap: 18px;
    align-content: center;
  }
  .crumbs {
    font-size: 0.82rem;
    color: var(--muted);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .item__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
  }
  .item__desc {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: var(--muted);
    max-width: 40ch;
  }
  .item__buy :global(.item__wa) {
    min-height: 52px;
    padding: 0 20px;
    font-size: 0.95rem;
  }
  .item__sold {
    width: fit-content;
    display: none;
  }
  .item[data-sold] .item__sold {
    display: inline-flex;
  }
  .item__buy {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .item__buy .qty button {
    width: 48px;
    height: 48px;
  }
  .item__pickup {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--olive-soft);
    color: var(--olive-deep);
    font-size: 0.9rem;
    max-width: 52ch;
  }
  .item__pickup :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 1px;
  }
  .item__events {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .item__events a {
    color: var(--olive);
    font-weight: 600;
  }
  .related {
    padding-block: clamp(90px, 12vw, 150px);
  }
  .related h2 {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 60px);
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 32px);
  }
  @media (max-width: 860px) {
    .item__grid {
      grid-template-columns: 1fr;
    }
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }
  }
</style>
