---
import Base from '../../layouts/Base.astro';
import MenuGrid from '../../components/MenuGrid.astro';
import Leaf from '../../components/Leaf.astro';
import { site } from '../../site.config';
import { menu, productsIn, slugOf } from '../../lib/menu';
import { faqs, menuIntro, seo } from '../../content/copy';

const cats = menu.categories.filter((c) => productsIn(c.id).length);
const schema = [
  {
    '@type': 'Menu',
    '@id': `${site.url}/menu#menu`,
    name: 'ESSENCE menu',
    url: `${site.url}/menu`,
    inLanguage: 'en-PK',
    hasMenuSection: cats.map((c) => ({
      '@type': 'MenuSection',
      name: c.name,
      hasMenuItem: productsIn(c.id).map((p) => ({
        '@type': 'MenuItem',
        name: p.name,
        description: p.description,
        url: `${site.url}/menu/${slugOf(p.id)}`,
      })),
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Menu', item: `${site.url}/menu` },
    ],
  },
];
---

<Base title={seo.menu.title} description={seo.menu.description} path="/menu" schema={schema}>
  <section class="menu-hero">
    <Leaf draw class="menu-hero__leaf" />
    <div class="wrap">
      <p class="eyebrow">{menuIntro.eyebrow}</p>
      <h1 class="display">Our <em class="accent">menu</em></h1>
      <p class="lead">{menuIntro.body[0]}</p>
      <nav class="jump" aria-label="Categories">
        {cats.map((c) => <a href={`#${c.id.replace(/^cat-/, '')}`}>{c.name}</a>)}
      </nav>
    </div>
  </section>

  <div class="menu-body-bg textured">
    <Leaf draw class="sprig sprig--tl" />
    <Leaf draw class="sprig sprig--br" />
    <div class="wrap">
      <MenuGrid mode="sections" />
    </div>
  </div>

  <section class="section menu-more">
    <div class="wrap menu-more__grid">
      <div data-reveal>
        <p class="eyebrow">Pickup in Bahria Town Phase 8</p>
        <h2 class="h2">Order ahead, <em class="accent">collect in store.</em></h2>
        <p class="lead">{menuIntro.body[1]}</p>
        <p class="menu-more__events">Ordering for an office meeting or a celebration? <a href="/corporate-events">Corporate & events enquiries</a></p>
      </div>
      <div class="faq" data-reveal>
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .menu-hero {
    position: relative;
    padding: calc(var(--nav-h) + clamp(48px, 8vw, 110px)) 0 clamp(56px, 7vw, 90px);
    text-align: center;
    overflow: hidden;
  }
  .menu-hero :global(.menu-hero__leaf) {
    position: absolute;
    left: -30px;
    bottom: -20px;
    width: clamp(140px, 18vw, 240px);
    color: var(--olive);
    opacity: 0.5;
  }
  .menu-hero .wrap {
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .menu-hero .lead {
    text-align: center;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }
  .jump a {
    padding: 11px 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--sand);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background-color 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .jump a:hover {
    background: var(--olive);
    color: var(--cream);
    box-shadow: none;
  }
  .menu-body-bg {
    padding-block: clamp(64px, 8vw, 110px);
  }
  .menu-more {
    background: var(--cream);
  }
  .menu-more__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .menu-more__grid > div:first-child {
    display: grid;
    gap: 22px;
  }
  .menu-more__events {
    color: var(--muted);
  }
  .menu-more__events a {
    color: var(--olive);
    font-weight: 600;
  }
  .faq {
    display: grid;
    gap: 10px;
  }
  details {
    border-radius: 18px;
    background: var(--beige-light);
    padding: 4px 22px;
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 0;
    font: 500 1.15rem/1.3 var(--serif);
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font: 400 1.4rem/1 var(--sans);
    color: var(--olive);
    transition: transform 0.3s var(--ease);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    padding-bottom: 18px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .menu-more__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
