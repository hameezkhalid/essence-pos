---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Story from '../components/Story.astro';
import MenuGrid from '../components/MenuGrid.astro';
import Gatherings from '../components/Gatherings.astro';
import Pickup from '../components/Pickup.astro';
import Visit from '../components/Visit.astro';
import Icon from '../components/Icon.astro';
import Leaf from '../components/Leaf.astro';
import { featured, seo } from '../content/copy';
---

<Base title={seo.home.title} description={seo.home.description} path="/" dark>
  <Hero />
  <Marquee />
  <Story />

  <section class="section home-menu textured" id="menu">
    <Leaf draw class="sprig sprig--tl" />
    <Leaf draw class="sprig sprig--br" />
    <div class="wrap">
      <header class="section-head home-menu__head">
        <p class="eyebrow" data-reveal>{featured.kicker}</p>
        <h2 class="h2" data-reveal>{featured.title}</h2>
        <p class="lead" data-reveal>{featured.body}</p>
      </header>
      <MenuGrid mode="tabs" />
      <p class="home-menu__more" data-reveal>
        <a class="btn btn--ghost" href="/menu">{featured.button} <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <Gatherings />
  <Pickup />
  <Visit />
</Base>

<style>
  .home-menu__head {
    text-align: center;
    justify-items: center;
  }
  .home-menu__head .lead {
    text-align: center;
  }
  .home-menu__more {
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 6vw, 72px);
    color: var(--olive);
  }
</style>
