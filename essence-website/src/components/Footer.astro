---
import Icon from './Icon.astro';
import Leaf from './Leaf.astro';
import Social from './Social.astro';
import { site } from '../site.config';
import { waLink } from '../lib/wa';
import { brand, contact, nav } from '../content/copy';

const wa = waLink(site.whatsapp, 'I have a question.');

const year = new Date().getFullYear();
---

<footer class="footer grain">
  <div class="wrap footer__top">
    <div class="footer__intro">
      <p class="script footer__script">Good food · Good mood</p>
      <h2 class="footer__heading">{contact.title}</h2>
      <p class="footer__closing">{contact.body}</p>
      <div class="footer__ctas">
        <a class="btn btn--whatsapp" data-wa="I have a question." href={wa || '#'} target="_blank" rel="noopener" hidden={!wa}><Icon name="whatsapp" /> WhatsApp Us</a>
        <a class="btn btn--cream" href="/contact">Contact Us</a>
        <a class="btn btn--ghost" href="/menu">Explore the Menu</a>
      </div>
    </div>
    <nav class="footer__col" aria-label="Footer">
      <h2>Explore</h2>
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="footer__col">
      <h2>Visit</h2>
      <p data-live="address">{site.address}</p>
      <p>{brand.location}</p>
      <p data-live="hours" hidden={!site.hours}>{site.hours}</p>
      <a href={site.mapsUrl} target="_blank" rel="noopener">Get directions</a>
      <Social class="footer__social" />
    </div>
  </div>
  <div class="footer__mark" aria-hidden="true">
    <span data-mark>Essence</span>
    <Leaf variant="twin" class="footer__leaf" />
  </div>
  <div class="wrap footer__base">
    <p>© {year} {brand.full} · {site.area}, {site.city}</p>
    <p>Pickup orders only · Pay at the counter</p>
    <p class="footer__credit">Powered by <a href="https://nibnox.com" target="_blank" rel="noopener">Nibnox (SMC-Private) Ltd.</a></p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--cocoa);
    color: var(--on-dark);
    padding-top: clamp(72px, 10vw, 120px);
    overflow: hidden;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
  }
  .footer__script {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--gold);
    margin-bottom: 14px;
  }
  .footer__heading {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    margin-bottom: 12px;
  }
  .footer__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .footer__ctas .btn--ghost {
    color: var(--on-dark);
  }
  .footer__closing {
    color: var(--on-dark-muted);
    max-width: 44ch;
    margin-bottom: 26px;
  }
  .footer__col {
    display: grid;
    align-content: start;
    gap: 10px;
    color: var(--on-dark-muted);
  }
  .footer__col h2 {
    font: 600 0.72rem/1 var(--sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
  }
  .footer__col a {
    text-decoration: none;
    width: fit-content;
    transition: color 0.2s;
  }
  .footer__col a:hover {
    color: var(--on-dark);
  }
  .footer__col :global(.footer__social) {
    margin-top: 8px;
    color: var(--gold);
    --social-hover: var(--cocoa);
  }
  .footer__mark {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: clamp(48px, 8vw, 96px);
    font: 500 clamp(5rem, 22vw, 20rem) / 0.8 var(--serif);
    letter-spacing: -0.02em;
    color: rgb(246 239 226 / 7%);
    user-select: none;
  }
  .footer__mark :global(.footer__leaf) {
    width: clamp(40px, 8vw, 120px);
    color: rgb(217 183 126 / 55%);
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 28px;
    border-top: 1px solid rgb(246 239 226 / 12%);
    font-size: 0.82rem;
    color: var(--on-dark-muted);
  }
  .footer__credit {
    flex-basis: 100%;
    text-align: center;
    padding-top: 14px;
    border-top: 1px solid rgb(246 239 226 / 8%);
  }
  .footer__credit a {
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid rgb(217 183 126 / 40%);
    transition: color 0.2s, border-color 0.2s;
  }
  .footer__credit a:hover {
    color: var(--on-dark);
    border-color: currentColor;
  }
  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__intro {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
