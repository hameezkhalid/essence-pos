---
import Icon from './Icon.astro';
import { site } from '../site.config';

interface Props { class?: string; labels?: boolean }
const { class: cls = '', labels = false } = Astro.props;
const links = [
  { name: 'Instagram', icon: 'instagram' as const, href: site.instagramUrl, handle: `@${site.instagram}` },
  { name: 'Facebook', icon: 'facebook' as const, href: site.facebookUrl, handle: 'ESSENCE' },
];
---

<ul class:list={['social', cls]}>
  {
    links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener" aria-label={`ESSENCE on ${l.name}`}>
          <Icon name={l.icon} />
          {labels && <span>{l.name}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 10px;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px currentColor;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: transform 0.35s var(--ease), background-color 0.3s, color 0.3s;
  }
  .social a:hover {
    transform: translateY(-2px);
    background: currentColor;
  }
  .social a:hover :global(svg),
  .social a:hover span {
    color: var(--social-hover, var(--cream));
  }
  .social :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
