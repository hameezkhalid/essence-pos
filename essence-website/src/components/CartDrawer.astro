---
import Icon from './Icon.astro';
import WaAsk from './WaAsk.astro';
import { pickup } from '../content/copy';
---

<dialog class="drawer" data-cart aria-labelledby="cart-title">
  <div class="drawer__panel">
    <header class="drawer__head">
      <button class="icon-btn" type="button" data-cart-back hidden aria-label="Back to cart"><Icon name="arrow" class="flip" /></button>
      <h2 id="cart-title" data-cart-title>Your order</h2>
      <button class="icon-btn" type="button" data-close-cart aria-label="Close"><Icon name="close" /></button>
    </header>

    <div class="pickup" role="note">
      <span class="pickup__icon"><Icon name="bag" /></span>
      <p><strong>Pickup order</strong>{pickup.banner.replace('Pickup only.', '')}</p>
    </div>

    <div class="drawer__body" data-lenis-prevent>
      <section data-view="cart">
        <ul class="lines" data-lines></ul>
        <div class="empty" data-empty hidden>
          <p class="script">Nothing sweet yet</p>
          <p>Add a slice of something lovely.</p>
          <a class="btn btn--sm" href="/menu" data-close-cart>Browse the menu</a>
        </div>
      </section>

      <section data-view="checkout" hidden>
        <form class="form" data-checkout novalidate>
          <label class="field">
            <span>Mobile number <em>(for your WhatsApp confirmation)</em></span>
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0300 1234567" required maxlength="16" />
          </label>
          <label class="field">
            <span>Your name <em>(optional)</em></span>
            <input name="name" type="text" autocomplete="given-name" maxlength="40" placeholder="So we know who to look for" />
          </label>
          <label class="field">
            <span>Note <em>(optional)</em></span>
            <textarea name="note" rows="2" maxlength="200" placeholder="Candle, message on the box, pickup time…"></textarea>
          </label>
          <label class="hp" aria-hidden="true">Company <input name="company" tabindex="-1" autocomplete="off" /></label>
          <p class="form__error" data-error role="alert" hidden></p>
          <ul class="summary" data-summary></ul>
        </form>
      </section>

      <section data-view="done" hidden>
        <div class="done">
          <svg class="done__ring" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="54" pathLength="1"></circle>
            <path d="M40 62 L54 76 L82 46" pathLength="1"></path>
          </svg>
          <p class="eyebrow">Order placed</p>
          <p class="done__code" data-done-code>#·····</p>
          <p class="done__lead">Show this Order ID at the counter.</p>
          <p class="done__text">We’ll send a WhatsApp confirmation to <strong data-done-phone></strong> shortly. Then visit us in Bahria Town Phase 8 to collect your order.</p>
          <a class="btn btn--whatsapp btn--block" data-done-wa href="#" target="_blank" rel="noopener" hidden><Icon name="whatsapp" /> Ask about your order on WhatsApp</a>
          <a class="btn btn--ghost btn--block" href="/#visit" data-close-cart><Icon name="pin" /> Get directions</a>
        </div>
      </section>
    </div>

    <footer class="drawer__foot" data-foot>
      <div class="foot-note">
        <p>{pickup.confirm}</p>
        <WaAsk message="I have a question about an order." label="Ask us" />
      </div>
      <p class="paused" data-paused hidden></p>
      <button class="btn btn--block" type="button" data-next>Continue</button>
    </footer>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }
  .drawer::backdrop {
    background: rgb(34 21 14 / 45%);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.4s, overlay 0.4s allow-discrete, display 0.4s allow-discrete;
  }
  .drawer[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .drawer[open]::backdrop {
      opacity: 0;
    }
  }
  .drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(460px, 100%);
    background: var(--cream);
    display: flex;
    flex-direction: column;
    box-shadow: -30px 0 60px -30px rgb(34 21 14 / 40%);
    transform: translateX(100%);
    transition: transform 0.55s var(--ease);
  }
  .drawer.is-open .drawer__panel {
    transform: none;
  }
  .drawer__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 18px 20px 10px;
  }
  .drawer__head h2 {
    font-size: 1.7rem;
    margin-right: auto;
  }
  .icon-btn {
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 999px;
    background: var(--beige);
    display: grid;
    place-items: center;
    transition: background-color 0.2s, transform 0.3s var(--ease);
  }
  .icon-btn:hover {
    background: var(--sand);
    transform: rotate(90deg);
  }
  .icon-btn[data-cart-back]:hover {
    transform: translateX(-2px);
  }
  .icon-btn :global(svg) {
    width: 20px;
    height: 20px;
  }
  .icon-btn :global(.flip) {
    transform: scaleX(-1);
  }
  .pickup {
    margin: 4px 20px 8px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: 16px;
    background: var(--olive);
    color: var(--cream);
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .pickup strong {
    display: block;
    font-size: 0.95rem;
  }
  .pickup__icon {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgb(255 255 255 / 14%);
    display: grid;
    place-items: center;
  }
  .pickup__icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .drawer__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 20px 20px;
  }
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .lines :global(li) {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--sand);
  }
  .lines :global(.line__img) {
    width: 64px;
    height: 72px;
    border-radius: 999px 999px 12px 12px;
    object-fit: cover;
    background: var(--beige);
  }
  .lines :global(.line__name) {
    font: 500 1.08rem/1.2 var(--serif);
    text-decoration: none;
  }
  .lines :global(.line__meta) {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .lines :global(.line__right) {
    display: grid;
    justify-items: end;
    gap: 8px;
  }
  .foot-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .foot-note :global(.wa-ask) {
    flex: none;
  }
  .lines :global(.qty button) {
    width: 32px;
    height: 32px;
  }
  .empty {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 48px 0;
    color: var(--muted);
  }
  .empty .script {
    font-size: 2.6rem;
    color: var(--coffee);
  }
  .form {
    display: grid;
    gap: 16px;
    padding-top: 8px;
  }
  .field {
    display: grid;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .field em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }
  .field input,
  .field textarea {
    font: 400 1.05rem/1.4 var(--sans);
    padding: 14px 16px;
    border-radius: 14px;
    border: 1.5px solid var(--sand);
    background: var(--paper);
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--olive);
    box-shadow: 0 0 0 4px rgb(78 87 38 / 14%);
  }
  .field input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .form__error {
    padding: 10px 14px;
    border-radius: 12px;
    background: #f6e1dc;
    color: var(--danger);
    font-size: 0.88rem;
  }
  .summary {
    list-style: none;
    padding: 14px 16px;
    margin: 0;
    border-radius: 16px;
    background: var(--beige);
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .summary :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .drawer__foot {
    padding: 16px 20px max(20px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--sand);
    background: var(--paper);
    display: grid;
    gap: 8px;
  }
  .paused {
    padding: 10px 12px;
    border-radius: 12px;
    background: #f3e6cc;
    color: #6b4a0c;
    font-size: 0.85rem;
  }
  .drawer__foot .btn {
    margin-top: 6px;
  }
  .done {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 12px;
    padding: 16px 0 8px;
  }
  .done__ring {
    width: 96px;
    height: 96px;
    margin-bottom: 4px;
  }
  .done__ring circle,
  .done__ring path {
    fill: none;
    stroke: var(--olive);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .done.is-in .done__ring circle {
    transition: stroke-dashoffset 0.9s var(--ease);
    stroke-dashoffset: 0;
  }
  .done.is-in .done__ring path {
    transition: stroke-dashoffset 0.5s 0.7s var(--ease);
    stroke-dashoffset: 0;
  }
  .done__code {
    font: 600 clamp(2.8rem, 12vw, 3.6rem) / 1 var(--serif);
    letter-spacing: 0.08em;
    color: var(--cocoa);
  }
  .done__lead {
    font-weight: 600;
  }
  .done__text {
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 34ch;
    margin-bottom: 8px;
  }
</style>
