---
// WhatsApp button that opens a chat with the shop, message already written.
// The number comes live from the POS (or site.config), so the link is filled in by the browser.
import Icon from './Icon.astro';
import { site } from '../site.config';
import { waLink } from '../lib/wa';

interface Props { message: string; label?: string; class?: string; compact?: boolean }
const { message, label = 'Ask on WhatsApp', class: cls = '', compact = false } = Astro.props;
const href = waLink(site.whatsapp, message);
---

<a
  class:list={['wa-ask', { 'wa-ask--compact': compact }, cls]}
  href={href || '#'}
  target="_blank"
  rel="noopener"
  data-wa={message}
  hidden={!href}
  aria-label={compact ? label : undefined}
  title={compact ? label : undefined}
>
  <Icon name="whatsapp" />
  {!compact && <span>{label}</span>}
</a>
